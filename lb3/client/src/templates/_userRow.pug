mixin userRow(user)
  tr
    td: img(src=user.photo, width="40" class="rounded-circle border")
    td= user.fullName
    td= user.birthDate
    td= user.email
    td.badge.bg-secondary= user.role
    td.badge.bg-info= user.status
    td
      button.btn.btn-sm.btn-secondary.me-1(type="button") Редактировать
      button.btn.btn-sm.btn-warning.me-1(type="button") Роль
      button.btn.btn-sm.btn-info.me-1(type="button") Статус
      button.btn.btn-sm.btn-danger(type="button") Удалить
