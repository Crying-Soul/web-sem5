extends index.pug

block content
  .card.shadow-sm.mt-4
    .card-header.bg-primary.text-white
      h2.mb-0 Пользователи
    .card-body.bg-white
      table.table.table-bordered.align-middle
        thead.table-light
          tr
            th Фото
            th ФИО
            th Дата рождения
            th Email
            th Роль
            th Статус
            th Действия
        tbody
          each user in users
            +userRow(user)
