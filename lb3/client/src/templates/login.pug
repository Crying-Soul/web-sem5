form#loginForm.p-4.border.rounded.bg-light
  h2.mb-3 Вход
  .mb-3
    label.form-label(for="email") Email
    input#email.form-control(type="email" required)
  .mb-3
    label.form-label(for="password") Пароль
    input#password.form-control(type="password" required)
  .mb-3.text-danger#login-error(style="display:none")
  button.btn.btn-primary.w-100(type="submit") Войти
